<mxfile host="Electron" type="device">
  <diagram id="sequence" name="Urutan pesan MCP">
    <mxGraphModel dx="1000" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Perjalanan pertanyaan token: dari chat ke kutipan" style="text;html=1;fontSize=23;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="940" height="45" as="geometry"/></mxCell>
        <mxCell id="a" value="Pengguna" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="180" height="60" as="geometry"/></mxCell>
