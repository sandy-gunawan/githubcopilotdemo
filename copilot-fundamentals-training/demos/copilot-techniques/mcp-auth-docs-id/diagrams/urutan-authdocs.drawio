        <mxCell id="c" value="Python authDocs" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="535" y="90" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d" value="File Markdown" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="la" style="dashed=1;endArrow=none;strokeColor=#94A3B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="150" as="sourcePoint"/><mxPoint x="120" y="1030" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lb" style="dashed=1;endArrow=none;strokeColor=#94A3B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="150" as="sourcePoint"/><mxPoint x="375" y="1030" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lc" style="dashed=1;endArrow=none;strokeColor=#94A3B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="150" as="sourcePoint"/><mxPoint x="635" y="1030" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ld" style="dashed=1;endArrow=none;strokeColor=#94A3B8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="150" as="sourcePoint"/><mxPoint x="880" y="1030" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m1" value="1. Start: jalankan Python sesuai mcp.json" style="endArrow=block;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="215" as="sourcePoint"/><mxPoint x="635" y="215" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. initialize + negosiasi kemampuan" style="endArrow=block;startArrow=block;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="290" as="sourcePoint"/><mxPoint x="635" y="290" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. tools/list: kenali search_auth_docs" style="endArrow=block;startArrow=block;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="365" as="sourcePoint"/><mxPoint x="635" y="365" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4. Tanya alur token" style="endArrow=block;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="460" as="sourcePoint"/><mxPoint x="375" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="select" value="Model memilih tool + argumen&#xa;Host menjalankan panggilan yang diizinkan" style="rounded=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="245" y="490" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="m5" value="5. tools/call: query=token, limit=8" style="endArrow=block;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="600" as="sourcePoint"/><mxPoint x="635" y="600" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="m6" value="6. Baca *.md" style="endArrow=block;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="675" as="sourcePoint"/><mxPoint x="880" y="675" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="7. Isi dokumen" style="endArrow=block;dashed=1;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="750" as="sourcePoint"/><mxPoint x="635" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="search" value="Validasi input; cocokkan frasa per paragraf&#xa;Berhenti setelah 8 kecocokan" style="rounded=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="510" y="775" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="m8" value="8. matches: file + excerpt" style="endArrow=block;dashed=1;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="890" as="sourcePoint"/><mxPoint x="375" y="890" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="m9" value="9. Jawaban 4 langkah dari kutipan" style="endArrow=block;dashed=1;strokeWidth=2;fontSize=16;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="980" as="sourcePoint"/><mxPoint x="120" y="980" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
        <mxCell id="note" value="1-3: saat koneksi dibuka. 4-9: saat pertanyaan membutuhkan tool. limit=8 adalah contoh, bukan konfigurasi tetap." style="text;whiteSpace=wrap;html=1;fontSize=15;align=center;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="50" y="1040" width="900" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
