<mxfile host="Electron" type="device">
  <diagram id="architecture" name="Arsitektur authDocs">
    <mxGraphModel dx="1000" dy="1080" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1080" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="authDocs: asisten mencari di perpustakaan dokumen" style="text;html=1;fontSize=23;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="45" as="geometry"/></mxCell>
        <mxCell id="user" value="PENGGUNA / PEMBACA&#xa;&quot;Jelaskan alur token MyCorp-Auth dalam 4 langkah&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="580" height="80" as="geometry"/></mxCell>
        <mxCell id="host" value="VS Code + Copilot = meja layanan perpustakaan" style="swimlane;html=1;startSize=42;rounded=1;fillColor=#F4F8FF;swimlaneFillColor=#F4F8FF;strokeColor=#6C8EBF;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="800" height="220" as="geometry"/></mxCell>
        <mxCell id="ai" value="Model AI / asisten&#xa;Memilih tool dan menulis jawaban&#xa;Lokasi/provider model tidak ditetapkan di mcp.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;" vertex="1" parent="host"><mxGeometry x="30" y="70" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="client" value="MCP client / penghubung&#xa;Menemukan dan memanggil tool&#xa;Menjalankan proses Python dari konfigurasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;" vertex="1" parent="host"><mxGeometry x="420" y="70" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="config" value=".vscode\mcp.json&#xa;Petunjuk executable + script&#xa;type = stdio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="transport" value="STDIO = jalur pesan lokal&#xa;stdin: permintaan / stdout: balasan&#xa;JSON-RPC; tidak membuka port HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="410" y="505" width="450" height="90" as="geometry"/></mxCell>
        <mxCell id="server" value="PROSES PYTHON LOKAL / petugas arsip" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#F1F8EF;swimlaneFillColor=#F1F8EF;strokeColor=#82B366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="100" y="650" width="800" height="175" as="geometry"/></mxCell>
        <mxCell id="sdk" value="FastMCP(&quot;authDocs&quot;)&#xa;Mengurus protokol MCP&#xa;Log ke stderr, bukan stdout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;" vertex="1" parent="server"><mxGeometry x="25" y="65" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="tool" value="search_auth_docs(query, limit)&#xa;Cari frasa literal, abaikan kapital&#xa;Hasil: file + excerpt (kutipan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;" vertex="1" parent="server"><mxGeometry x="415" y="65" width="355" height="85" as="geometry"/></mxCell>
        <mxCell id="docs" value="mycorp-auth-docs\**\*.md / rak dokumen&#xa;overview.md, token_flow.md, troubleshooting.md, subfolder&#xa;Baca file lokal; tidak menghubungi LDAP atau layanan login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="160" y="890" width="680" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" style="endArrow=block;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="user" target="host"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#6C8EBF;" edge="1" parent="host" source="ai" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#9673A6;" edge="1" parent="1" source="client" target="transport"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="dibaca host" style="endArrow=block;dashed=1;strokeColor=#D79B00;fontSize=14;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="config" target="host"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#9673A6;" edge="1" parent="1" source="transport" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#82B366;" edge="1" parent="server" source="sdk" target="tool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="baca / hasil kutipan" style="endArrow=block;startArrow=block;strokeWidth=2;strokeColor=#82B366;fontSize=14;" edge="1" parent="1" source="server" target="docs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Panah dua arah = permintaan dan balasan. Ini bukan diagram deployment Azure." style="text;html=1;fontSize=15;align=center;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="840" height="35" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
