<mxfile host="app.diagrams.net" type="device"><diagram id="peta-belajar" name="peta-belajar"><mxGraphModel dx="1000" dy="1310" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1310" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Belajar MCP dari satu pertanyaan" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Cerita yang sama di semua bab: Mengapa jaringan Bandung lambat?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="920" height="55" as="geometry"/></mxCell>
<mxCell id="stage-0" value="&lt;b&gt;1. Engineer bertanya&lt;/b&gt;&lt;br&gt;Buka chat NetOps Lab&lt;br&gt;Mengapa branch Bandung lambat?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="190" y="165" width="620" height="115" as="geometry"/></mxCell>
<mxCell id="stage-1" value="&lt;b&gt;2. Agent memilih layanan&lt;/b&gt;&lt;br&gt;Asisten melihat daftar tools MCP&lt;br&gt;Butuh angka perangkat dan isi dokumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="190" y="345" width="620" height="115" as="geometry"/></mxCell>
<mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stage-0" target="stage-1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="stage-2" value="&lt;b&gt;3. Tool membaca tabel&lt;/b&gt;&lt;br&gt;get_device / get_device_metrics&lt;br&gt;BR-SW-01: uplink 95%, loss 3.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="190" y="525" width="620" height="115" as="geometry"/></mxCell>
<mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stage-1" target="stage-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="stage-3" value="&lt;b&gt;4. Tool membaca pengetahuan&lt;/b&gt;&lt;br&gt;search_documents lalu get_document&lt;br&gt;Runbook, log dan catatan incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="190" y="705" width="620" height="115" as="geometry"/></mxCell>
<mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stage-2" target="stage-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="stage-4" value="&lt;b&gt;5. Agent menyusun jawaban&lt;/b&gt;&lt;br&gt;Gabungkan angka dengan konteks&lt;br&gt;Bukti berbeda dengan dugaan penyebab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="190" y="885" width="620" height="115" as="geometry"/></mxCell>
<mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stage-3" target="stage-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="stage-5" value="&lt;b&gt;6. Jika ingin mengubah data&lt;/b&gt;&lt;br&gt;Preview dan request dahulu&lt;br&gt;Manusia menyetujui; audit mencatat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="190" y="1065" width="620" height="115" as="geometry"/></mxCell>
<mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="stage-4" target="stage-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="footer" value="Aplikasi berjalan sungguhan. Seluruh perangkat dan data network adalah simulasi." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="880" height="45" as="geometry"/></mxCell>
