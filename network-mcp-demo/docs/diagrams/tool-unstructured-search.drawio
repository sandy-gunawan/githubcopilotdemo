<mxfile host="app.diagrams.net" type="device"><diagram id="tool-unstructured-search" name="tool-unstructured-search"><mxGraphModel dx="1100" dy="1450" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1450" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Di balik pencarian dan pembacaan dokumen" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Cari map yang relevan dahulu, lalu buka isi lengkapnya. Unstructured juga disimpan di SQLite." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="source" value="&lt;b&gt;SEBELUM CHAT: DOKUMEN SUDAH DI-INGEST&lt;/b&gt;&lt;br&gt;File runbook / incident / config / log&lt;br&gt;Body disimpan di documents; katalog isi dibuat di FTS5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="155" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="search" value="&lt;b&gt;1. search_documents&lt;/b&gt;&lt;br&gt;Keyword: congestion; filter deviceId: br-sw-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="330" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="source" target="search"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="index" value="&lt;b&gt;2. Service mencari di katalog FTS5&lt;/b&gt;&lt;br&gt;documents_fts MATCH parameter&lt;br&gt;Cari title, content dan tags; bukan vector search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="505" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="search" target="index"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="hits" value="&lt;b&gt;3. Hasil search: daftar, bukan body penuh&lt;/b&gt;&lt;br&gt;ID, judul, cuplikan, ranking&lt;br&gt;Contoh: doc-branch-runbook dan doc-branch-log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="680" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="index" target="hits"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="read" value="&lt;b&gt;4. get_document&lt;/b&gt;&lt;br&gt;documentId: doc-branch-runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="855" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hits" target="read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="sql" value="&lt;b&gt;5. Baca satu dokumen&lt;/b&gt;&lt;br&gt;SELECT * FROM documents WHERE id = ?&lt;br&gt;Parameter: doc-branch-runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="1030" width="780" height="115" as="geometry"/></mxCell>
