<mxCell id="note" value="&lt;b&gt;Model menggabungkan teks dengan angka&lt;/b&gt;&lt;br&gt;95% utilisasi + 3.2% loss mendukung dugaan congestion; penyebab backup belum terbukti." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="1380" width="960" height="60" as="geometry"/></mxCell>
