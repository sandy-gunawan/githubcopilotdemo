<mxCell id="title" value="MCP seperti loket di kantor operasi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Bayangkan satu kantor: engineer, asisten, loket layanan dan petugas arsip." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="920" height="55" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;b&gt;ENGINEER / USER&lt;/b&gt;&lt;br&gt;Orang yang membutuhkan jawaban&lt;br&gt;Mengapa koneksi Bandung lambat?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="210" y="160" width="580" height="100" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;ASISTEN / AGENT&lt;/b&gt;&lt;br&gt;Memahami pertanyaan, memilih formulir layanan&lt;br&gt;Tidak hafal isi lemari arsip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="210" y="335" width="580" height="105" as="geometry"/></mxCell>
<mxCell id="mcp" value="&lt;b&gt;LOKET / MCP SERVER&lt;/b&gt;&lt;br&gt;Menawarkan daftar tools dan menerima permintaan&lt;br&gt;Aturan formulir yang sama disebut protokol MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="210" y="515" width="580" height="115" as="geometry"/></mxCell>
<mxCell id="service" value="&lt;b&gt;PETUGAS / NETWORK SERVICE&lt;/b&gt;&lt;br&gt;Memeriksa permintaan dan menjalankan pekerjaan&lt;br&gt;Membaca tabel atau mencari isi catatan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="210" y="705" width="580" height="105" as="geometry"/></mxCell>
