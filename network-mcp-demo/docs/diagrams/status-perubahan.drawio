        <mxCell id="failed" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;Approve, validasi gagal&lt;br&gt;Contoh: stale version&lt;br&gt;Tidak menimpa data terbaru" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="680" y="660" width="270" height="150" as="geometry"/></mxCell>
