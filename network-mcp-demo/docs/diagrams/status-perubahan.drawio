        <mxCell id="pending" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;Request berhasil dibuat&lt;br&gt;Target masih VLAN 10, versi 1&lt;br&gt;Menunggu keputusan manusia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=19;spacing=12;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="360" height="140" as="geometry"/></mxCell>
