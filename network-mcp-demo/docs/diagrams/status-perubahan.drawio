        <mxCell id="subtitle" value="Contoh: BR-SW-01 Gi0/2 dari VLAN 10 ke VLAN 20. Approval hanya oleh manusia." style="text;html=1;whiteSpace=wrap;align=left;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="920" height="50" as="geometry"/></mxCell>
