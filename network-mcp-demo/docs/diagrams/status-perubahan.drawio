        <mxCell id="end-a" value="" style="ellipse;shape=endState;html=1;fillColor=#17243B;strokeColor=#17243B;" vertex="1" parent="1"><mxGeometry x="485" y="900" width="30" height="30" as="geometry"/></mxCell>
