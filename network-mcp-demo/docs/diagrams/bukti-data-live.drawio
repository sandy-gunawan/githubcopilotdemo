<mxfile host="app.diagrams.net" type="device">
  <diagram id="bukti-data-live" name="Bukti SQL membaca data terbaru">
    <mxGraphModel dx="1100" dy="1290" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1290" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Buktikan data dibaca saat diminta" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#17243B;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Isi network tetap simulasi. SQL dan MCP membaca SQLite yang sama, bukan jawaban hardcoded." style="text;html=1;whiteSpace=wrap;align=left;fontSize=18;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1020" height="55" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;FILE SQLITE YANG SAMA&lt;/b&gt;&lt;br&gt;data\runtime\network.sqlite&lt;br&gt;Yang diuji: description BR-SW-01" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=19;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="310" y="175" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="sql" value="SQL READ-ONLY" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#17243B;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="web" value="APLIKASI / MANUSIA" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#17243B;" vertex="1" parent="1"><mxGeometry x="400" y="385" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="mcp" value="MCP / AGENT" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#17243B;" vertex="1" parent="1"><mxGeometry x="760" y="385" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="s-before" value="&lt;b&gt;1. Baca sebelum perubahan&lt;/b&gt;&lt;br&gt;Deskripsi lama&lt;br&gt;Versi 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="w-before" value="&lt;b&gt;Kondisi awal&lt;/b&gt;&lt;br&gt;Buka BR-SW-01&lt;br&gt;Belum mengajukan perubahan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="m-before" value="&lt;b&gt;get_device membaca&lt;/b&gt;&lt;br&gt;Deskripsi lama yang sama&lt;br&gt;Versi 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="450" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="s-pending" value="&lt;b&gt;2. Jalankan SQL lagi&lt;/b&gt;&lt;br&gt;Masih deskripsi lama&lt;br&gt;Target belum berubah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="w-pending" value="&lt;b&gt;Ajukan request&lt;/b&gt;&lt;br&gt;Target deskripsi: BUKTI-LIVE-...&lt;br&gt;Status pending, belum approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="400" y="675" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="m-pending" value="&lt;b&gt;Baca ulang lewat MCP&lt;/b&gt;&lt;br&gt;Masih deskripsi lama&lt;br&gt;Membuat request bukan apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="675" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="s-after" value="&lt;b&gt;3. SQL melihat nilai baru&lt;/b&gt;&lt;br&gt;BUKTI-LIVE-... yang Anda pilih&lt;br&gt;Versi 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="w-after" value="&lt;b&gt;Manusia klik Setujui&lt;/b&gt;&lt;br&gt;Service validasi lalu commit&lt;br&gt;Request applied + audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="m-after" value="&lt;b&gt;MCP melihat nilai baru&lt;/b&gt;&lt;br&gt;Marker sama dengan SQL&lt;br&gt;Versi 2, tanpa restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="900" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="text-proof" value="&lt;b&gt;Ulangi untuk dokumen unstructured&lt;/b&gt;&lt;br&gt;Tambahkan kata unik pada incident melalui approval. SQL, get_document dan search_documents harus menemukannya setelah apply." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="1020" height="100" as="geometry"/></mxCell>
        <mxCell id="note" value="Waktu query sekarang tidak berarti waktu telemetry baru. Demo tidak mengambil data dari switch asli." style="text;html=1;whiteSpace=wrap;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="1020" height="45" as="geometry"/></mxCell>
        <mxCell id="db-s" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="db" target="sql"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="db-w" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="db" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="db-m" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="db" target="mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="s-next" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;" edge="1" parent="1" source="s-before" target="s-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-next" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;" edge="1" parent="1" source="w-before" target="w-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-next" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;" edge="1" parent="1" source="m-before" target="m-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-done" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;" edge="1" parent="1" source="s-pending" target="s-after"><mxGeometry relative="1" as="geometry"/></mxCell>
