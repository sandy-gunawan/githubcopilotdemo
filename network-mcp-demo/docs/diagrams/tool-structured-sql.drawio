<mxfile host="app.diagrams.net" type="device"><diagram id="tool-structured-sql" name="tool-structured-sql"><mxGraphModel dx="1100" dy="1390" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1390" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Di balik get_device: tool membaca tabel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Contoh nyata: deviceId = BR-SW-01. Agent memilih tool, bukan menulis SQL sendiri." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="call" value="&lt;b&gt;1. Permintaan tool&lt;/b&gt;&lt;br&gt;get_device({ deviceId: BR-SW-01 })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="155" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="handler" value="&lt;b&gt;2. Handler MCP meneruskan&lt;/b&gt;&lt;br&gt;NetworkService.getDevice(BR-SW-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="325" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="call" target="handler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="device" value="&lt;b&gt;3. Query tabel devices&lt;/b&gt;&lt;br&gt;SELECT * FROM devices&lt;br&gt;WHERE id = ? OR hostname = ? COLLATE NOCASE&lt;br&gt;Parameter: BR-SW-01, BR-SW-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="495" width="780" height="140" as="geometry"/></mxCell>
<mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="handler" target="device"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="id" value="&lt;b&gt;4. Ditemukan ID internal&lt;/b&gt;&lt;br&gt;id = br-sw-01; siteId = site-br&lt;br&gt;Hostname = BR-SW-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="700" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="device" target="id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="related" value="&lt;b&gt;5. Query tabel terkait&lt;/b&gt;&lt;br&gt;interfaces WHERE deviceId = br-sw-01&lt;br&gt;metrics: 24 sampel; alerts; metadata dokumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="870" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="id" target="related"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="rows" value="&lt;b&gt;6. Gabungkan hasil sebagai data&lt;/b&gt;&lt;br&gt;Gi0/1: utilizationPct = 95; errors = 1240&lt;br&gt;Metric terakhir: packetLossPct = 3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="1040" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="related" target="rows"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="return" value="&lt;b&gt;7. Kirim lewat MCP ke model&lt;/b&gt;&lt;br&gt;simulation: true; data: hasil query&lt;br&gt;Agent menjelaskan bukti kepada user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="1210" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rows" target="return"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="footer" value="Tanda ? adalah tempat nilai input yang diikat terpisah dari perintah SQL. Bukan akses database tanpa batas." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1320" width="980" height="55" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
