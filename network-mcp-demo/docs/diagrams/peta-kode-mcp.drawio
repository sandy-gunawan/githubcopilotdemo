<mxfile host="app.diagrams.net" type="device"><diagram id="peta-kode-mcp" name="peta-kode-mcp"><mxGraphModel dx="1100" dy="1440" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1440" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Peta file: pertanyaan Bandung sampai SQLite" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Cerita yang sama: Mengapa koneksi kantor cabang Bandung lambat? Device: BR-SW-01." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1020" height="50" as="geometry"/></mxCell>
<mxCell id="startup" value="&lt;b&gt;Sebelum menerima permintaan: wiring saat startup&lt;/b&gt;&lt;br&gt;server/index.ts membuat NetworkStore dan memanggil createApp().&lt;br&gt;server/app.ts membuat service + agent, lalu mountMcp(app, service, token)." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="65" y="145" width="970" height="100" as="geometry"/></mxCell>
<mxCell id="ui" value="&lt;b&gt;1. Browser: src/chat.tsx + src/api.ts&lt;/b&gt;&lt;br&gt;send() mengambil pesan.&lt;br&gt;request() mengirim lewat fetch()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="295" width="780" height="100" as="geometry"/></mxCell>
<mxCell id="route" value="&lt;b&gt;2. Backend: server/app.ts&lt;/b&gt;&lt;br&gt;Route /api/chat memvalidasi input,&lt;br&gt;lalu memanggil agent.chat(message, conversationId)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="450" width="780" height="95" as="geometry"/></mxCell>
<mxCell id="agent" value="&lt;b&gt;3. Agent: server/agent.ts&lt;/b&gt;&lt;br&gt;Runtime Copilot: model + MCP client bernama network.&lt;br&gt;Model memilih get_device; client mengirim input&lt;br&gt;deviceId = &quot;BR-SW-01&quot; ke URL MCP aplikasi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="600" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="mcp" value="&lt;b&gt;4. MCP server: server/mcp.ts&lt;/b&gt;&lt;br&gt;mountMcp() menerima request; SDK mencari handler.&lt;br&gt;registerTool(&quot;get_device&quot;, ...)&lt;br&gt;Handler: run(() =&gt; service.getDevice(deviceId))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="770" width="780" height="115" as="geometry"/></mxCell>
<mxCell id="service" value="&lt;b&gt;5. Pekerjaan dan SQL: server/service.ts&lt;/b&gt;&lt;br&gt;NetworkService.getDevice() memanggil device(),&lt;br&gt;lalu membaca site, interfaces, metrics, alerts dan documents.&lt;br&gt;Ini panggilan fungsi biasa, bukan tool MCP tambahan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="940" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="store" value="&lt;b&gt;6. Koneksi SQLite: server/store.ts&lt;/b&gt;&lt;br&gt;NetworkStore.db = new DatabaseSync(filename)&lt;br&gt;Database default: data\runtime\network.sqlite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="160" y="1100" width="780" height="105" as="geometry"/></mxCell>
<mxCell id="return" value="&lt;b&gt;Jalur balasan&lt;/b&gt;&lt;br&gt;SQLite -&gt; service -&gt; mcp.result(data) -&gt; client dan model&lt;br&gt;Model menyusun jawaban; agent mengirim { content, traces }&lt;br&gt;melalui route /api/chat untuk ditampilkan src/chat.tsx." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="65" y="1260" width="970" height="100" as="geometry"/></mxCell>
<mxCell id="edge-ui" value="POST /api/chat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ui" target="route"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-route" value="agent.chat(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="route" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-agent" value="POST /mcp : tools/call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-mcp" value="getDevice(deviceId)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mcp" target="service"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-service" value="store.db.prepare(sql).all(...args)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="service" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge-store" value="Hasil data kembali" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;strokeColor=#9673A6;strokeWidth=1.5;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="store" target="return"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="footer" value="MCP menghubungkan layanan. Service menentukan SQL. Data network tetap simulasi, bukan perangkat asli." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1020" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
