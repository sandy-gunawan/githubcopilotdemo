<mxfile host="app.diagrams.net" type="device">
  <diagram id="alur-ingestion" name="Alur ingestion dummy">
    <mxGraphModel dx="1000" dy="1280" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1280" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="NetOps Lab | Alur data masuk" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#17243B;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Sumber dummy deterministik, validasi, lalu satu transaksi SQLite." style="text;html=1;align=left;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="920" height="40" as="geometry"/></mxCell>
        <mxCell id="generator" value="&lt;b&gt;1. createSeed()&lt;/b&gt;&lt;br&gt;npm run data:generate&lt;br&gt;Angka dan ID selalu konsisten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="155" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="json" value="&lt;b&gt;2a. network.json&lt;/b&gt;&lt;br&gt;Site, device, interface, link,&lt;br&gt;VLAN, metrics, alert, metadata dokumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="files" value="&lt;b&gt;2b. File dokumen&lt;/b&gt;&lt;br&gt;.md: runbook / incident&lt;br&gt;.txt: config; .log: log simulasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="330" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="validation" value="&lt;b&gt;3. Baca + validasi bundle&lt;/b&gt;&lt;br&gt;Zod: tipe, ID, IP, ukuran konten&lt;br&gt;Path dokumen dibatasi folder seed&lt;br&gt;Hitung fingerprint SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="510" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="transaction" value="&lt;b&gt;4. Satu transaksi SQLite&lt;/b&gt;&lt;br&gt;Foreign key aktif; semua atau tidak sama sekali" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="715" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="relational" value="&lt;b&gt;Tabel structured&lt;/b&gt;&lt;br&gt;25 device, 102 interface, 24 link&lt;br&gt;9 VLAN, 600 metrics, 3 alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="890" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="documents" value="&lt;b&gt;Tabel documents&lt;/b&gt;&lt;br&gt;10 body teks unstructured&lt;br&gt;Metadata: jenis, site, device, versi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="890" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="metadata" value="&lt;b&gt;Metadata + audit ingestion&lt;/b&gt;&lt;br&gt;datasetVersion, snapshotAt, fingerprint&lt;br&gt;Dataset identik tidak menimpa runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#17243B;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="1075" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="fts" value="&lt;b&gt;Index FTS5&lt;/b&gt;&lt;br&gt;Trigger insert / update / delete&lt;br&gt;Search title, content dan tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1075" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="note" value="Jika validasi / foreign key gagal: rollback seluruh import. --reset harus eksplisit dan menghapus perubahan runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=16;fontColor=#17243B;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="1210" width="900" height="55" as="geometry"/></mxCell>
        <mxCell id="g-json" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="generator" target="json"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-files" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="generator" target="files"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="json-v" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="json" target="validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="files-v" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="files" target="validation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-t" value="npm run data:ingest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="validation" target="transaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-r" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="transaction" target="relational"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-d" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="transaction" target="documents"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t-m" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="transaction" target="metadata"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="762"/><mxPoint x="20" y="1127"/></Array></mxGeometry></mxCell>
