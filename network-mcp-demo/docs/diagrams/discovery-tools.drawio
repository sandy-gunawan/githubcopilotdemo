<mxfile host="app.diagrams.net" type="device"><diagram id="discovery-tools" name="discovery-tools"><mxGraphModel dx="1000" dy="1130" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1000" pageHeight="1130" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Bagaimana agent tahu tool yang tersedia?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="920" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Seperti melihat daftar layanan di loket sebelum mengisi formulir." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="920" height="55" as="geometry"/></mxCell>
<mxCell id="connect" value="&lt;b&gt;1. MCP client tersambung&lt;/b&gt;&lt;br&gt;Client ada di aplikasi agent&lt;br&gt;Server lokal: /mcp dengan token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="180" y="160" width="640" height="115" as="geometry"/></mxCell>
<mxCell id="catalog" value="&lt;b&gt;2. Server memberi daftar layanan&lt;/b&gt;&lt;br&gt;Nama tool, kegunaan dan kolom input&lt;br&gt;Contoh: get_device butuh deviceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="640" height="115" as="geometry"/></mxCell>
<mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="connect" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="choose" value="&lt;b&gt;3. Model memilih sesuai kebutuhan&lt;/b&gt;&lt;br&gt;Pertanyaan Bandung lambat butuh angka + teks&lt;br&gt;Bukan selalu memanggil semua 17 tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="180" y="520" width="640" height="115" as="geometry"/></mxCell>
<mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="catalog" target="choose"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="request" value="&lt;b&gt;4. Client mengirim permintaan&lt;/b&gt;&lt;br&gt;Tool: get_device&lt;br&gt;Parameter: deviceId = BR-SW-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="180" y="700" width="640" height="115" as="geometry"/></mxCell>
<mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="choose" target="request"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="validate" value="&lt;b&gt;5. Server memeriksa dan menjalankan&lt;/b&gt;&lt;br&gt;Input benar: service membaca data&lt;br&gt;Input salah: kirim error, jangan mengarang hasil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="180" y="880" width="640" height="115" as="geometry"/></mxCell>
<mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=wrap;endArrow=block;strokeColor=#64748B;strokeWidth=1.5;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="request" target="validate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="footer" value="Daftar layanan = tools/list. Menggunakan satu layanan = tools/call. Kode SDK menangani pesan protokol." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="880" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
