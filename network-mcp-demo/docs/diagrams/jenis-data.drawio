<mxCell id="title" value="Dua bentuk data, satu kasus Bandung" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Keduanya disimpan di SQLite. Yang berbeda adalah bentuk isi dan cara mencarinya." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#17243B;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1020" height="55" as="geometry"/></mxCell>
<mxCell id="structured" value="&lt;b&gt;STRUCTURED = FORMULIR BERKOLOM&lt;/b&gt;&lt;br&gt;Perangkat: BR-SW-01&lt;br&gt;Port: Gi0/1&lt;br&gt;Utilisasi: 95%&lt;br&gt;Error counter: 1240&lt;br&gt;Loss terakhir: 3.2% (tabel metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="480" height="245" as="geometry"/></mxCell>
<mxCell id="unstructured" value="&lt;b&gt;UNSTRUCTURED = CATATAN BEBAS&lt;/b&gt;&lt;br&gt;Runbook: periksa bila di atas 85%&lt;br&gt;Log: backup window dimulai 13:30 WIB&lt;br&gt;Incident: backup masih hipotesis&lt;br&gt;Config: snapshot konfigurasi teks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="580" y="175" width="480" height="245" as="geometry"/></mxCell>
<mxCell id="s-tool" value="&lt;b&gt;TOOLS UNTUK ANGKA&lt;/b&gt;&lt;br&gt;get_device&lt;br&gt;get_device_metrics&lt;br&gt;Query SQL membaca kolom / baris" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#17243B;fontSize=20;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="u-tool" value="&lt;b&gt;TOOLS UNTUK TEKS&lt;/b&gt;&lt;br&gt;search_documents: cari keyword&lt;br&gt;get_document: baca isi lengkap&lt;br&gt;Body teks tetap bebas, bukan diubah jadi kolom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#17243B;fontSize=19;spacing=12;" vertex="1" parent="1"><mxGeometry x="580" y="510" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="answer" value="&lt;b&gt;GABUNGKAN KEDUANYA&lt;/b&gt;&lt;br&gt;Angka menunjukkan uplink padat.&lt;br&gt;Catatan memberi konteks backup dan langkah pemeriksaan.&lt;br&gt;Belum cukup bukti untuk menyatakan backup pasti penyebab." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#17243B;fontSize=21;spacing=12;" vertex="1" parent="1"><mxGeometry x="200" y="765" width="700" height="160" as="geometry"/></mxCell>
