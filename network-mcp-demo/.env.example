# Copy ke .env. Tidak diperlukan API key untuk login GitHub Copilot lokal.
HOST=127.0.0.1
PORT=4173
# Kosong = model default yang disediakan akun Copilot.
COPILOT_MODEL=
# Opsional: gunakan CLI eksternal yang kompatibel; default SDK memakai runtime bawaannya.
COPILOT_CLI_PATH=
# Opsional: token khusus untuk MCP client eksternal. Gunakan nilai acak minimal 32 karakter.
# Tanpa nilai ini, server membuat token internal acak setiap startup.
MCP_API_TOKEN=
# Relatif terhadap folder aplikasi.
DATABASE_PATH=data/runtime/network.sqlite
